{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "de.christianalpen.reaperdeck",
  "name": "ReaperDeck",
  "version": "0.20.0",
  "description": "Controls REAPER from Macro Deck through REAPER's web interface - no hotkeys, REAPER does not need focus: actions, transport, items, tracks, markers and regions, faders, a timecode tile and more. Unofficial plugin, not affiliated with Cockos.",
  "publisher": {
    "name": "Christian Alpen"
  },
  "license": "TODO",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  },
  "repository": "https://github.com/halbius/Macrodeck-ReaperControl",
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": true
  },
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/ReaperControl.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/ReaperControl.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-x64": {
      "executable": "runtimes/osx-x64/ReaperControl.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  }
}
